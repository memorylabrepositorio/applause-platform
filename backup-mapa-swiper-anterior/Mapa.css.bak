/* fonte Marcellus carregada via <link> no index.html — não em @import aqui,
   pra evitar que uma falha de rede na fonte derrube o chunk lazy do Mapa */

/* ---------------------------------------------------------------------
   Mapa (página inicial) — carrossel 3D de esferas. Tudo escopado em
   .mapa — nada aqui vaza pros outros painéis. Cores neutras e o destaque
   saem dos mesmos tokens do tema (--ink-*, --brand-*), então o mapa
   acompanha claro/escuro e a cor de destaque escolhida em Configurações >
   Aparência.
   --------------------------------------------------------------------- */
.mapa {
  --m-texto: 236 229 216;
  --m-texto-2: 185 178 166;
  --m-texto-3: 140 135 127;
  --m-estrela: 255 255 255;
  --m-linha: rgb(255 255 255 / 0.09);
  --m-vidro: rgb(22 22 28 / 0.62);
  --m-fundo: radial-gradient(ellipse 60% 55% at 50% 30%, #161821 0%, #0b0c11 55%, #060709 100%);
  --m-display: "Marcellus", Georgia, serif;

  position: relative;
  height: calc(100dvh - 57px - 1.5rem);
  min-height: 480px;
  overflow: hidden;
  border-radius: 18px;
  border: 1px solid var(--m-linha);
  background: var(--m-fundo);
  color: rgb(var(--m-texto));
  isolation: isolate;
}
@media (min-width: 640px) {
  .mapa { height: calc(100dvh - 57px - 3rem); }
}
@media (min-width: 1024px) {
  .mapa { height: calc(100dvh - 3rem); }
}
.mapa:fullscreen { border-radius: 0; height: 100vh; }

:root[data-theme="light"] .mapa {
  --m-texto: var(--ink-100);
  --m-texto-2: var(--ink-300);
  --m-texto-3: var(--ink-400);
  --m-estrela: var(--ink-400);
  --m-linha: rgb(0 0 0 / 0.08);
  --m-vidro: rgb(255 255 255 / 0.72);
  --m-fundo: radial-gradient(ellipse 60% 55% at 50% 30%, #ffffff 0%, rgb(var(--ink-900)) 60%, rgb(var(--ink-800)) 100%);
}

.mapa button { cursor: pointer; }

/* estrelas */
.mapa-estrelas { position: absolute; inset: 0; pointer-events: none; }
.mapa-estrela {
  position: absolute;
  border-radius: 50%;
  background: rgb(var(--m-estrela));
  opacity: 0.5;
  animation: mapa-brilho ease-in-out infinite;
}
@keyframes mapa-brilho { 50% { opacity: 0.12; } }

/* barra do topo */
.mapa-topo {
  position: absolute; inset: 0 0 auto 0; z-index: 30;
  display: flex; align-items: center; gap: 8px; flex-wrap: nowrap;
  padding: 12px 16px; pointer-events: none;
}
.mapa-topo > * { pointer-events: auto; }
.mapa-btn { flex-shrink: 0; }
.mapa-vidro {
  background: var(--m-vidro);
  backdrop-filter: blur(10px);
  -webkit-backdrop-filter: blur(10px);
  border: 1px solid var(--m-linha);
}
.mapa-btn {
  width: 34px; height: 34px; border-radius: 9px;
  display: grid; place-items: center; color: rgb(var(--m-texto-2));
}
.mapa-btn:hover { color: rgb(var(--m-texto)); }
.mapa-busca-caixa { position: relative; width: min(280px, calc(100% - 140px)); min-width: 0; flex-shrink: 1; }
.mapa-busca {
  display: flex; align-items: center; gap: 8px;
  height: 34px; width: 100%;
  padding: 0 12px; border-radius: 9px; color: rgb(var(--m-texto-3));
}
.mapa-busca input {
  flex: 1; min-width: 0; background: transparent; border: 0; outline: 0;
  color: rgb(var(--m-texto)); font-size: 12.5px; font-weight: 500;
}
.mapa-busca input::placeholder { color: rgb(var(--m-texto-3)); }
.mapa-busca-n { font-size: 11px; font-variant-numeric: tabular-nums; color: rgb(var(--brand-400)); }
.mapa-aba {
  position: absolute; left: 50%; transform: translateX(-50%);
  padding: 7px 14px; border-radius: 8px;
  background: rgb(var(--m-texto)); color: rgb(var(--ink-900));
  font: 700 10px/1 system-ui, sans-serif; letter-spacing: 0.18em;
}
@media (max-width: 767px) { .mapa-aba { display: none; } }

.mapa-busca-lista {
  position: absolute; left: 0; top: calc(100% + 6px); width: 100%; z-index: 40;
  border-radius: 12px; overflow: hidden; padding: 5px;
  max-height: 260px; overflow-y: auto;
}
.mapa-busca-lista button {
  display: flex; align-items: center; gap: 9px; width: 100%; text-align: left;
  padding: 8px 9px; border-radius: 8px; background: transparent;
}
.mapa-busca-lista button:hover { background: rgb(255 255 255 / 0.06); }
.mapa-busca-lista i { width: 8px; height: 8px; border-radius: 50%; flex-shrink: 0; background: var(--c); box-shadow: 0 0 6px var(--c); }
.mapa-busca-lista i.dev { background: transparent; border: 1.4px solid var(--c); box-shadow: none; }
.mapa-busca-lista .nm { flex: 1; min-width: 0; font-size: 12.5px; color: rgb(var(--m-texto)); overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.mapa-busca-lista .dp { font-size: 10.5px; color: rgb(var(--m-texto-3)); flex-shrink: 0; }
.mapa-busca-vazio { padding: 10px; font-size: 12px; color: rgb(var(--m-texto-3)); text-align: center; }

/* ---------------------------------------------------------------------
   palco — uma "moldura" de referência fixa (REFERENCIA em carrossel.ts),
   centralizada e escalada pra caber na área visível. Tudo dentro dela
   usa coordenadas relativas ao próprio centro da moldura.
   --------------------------------------------------------------------- */
.mapa-viewport { position: absolute; inset: 0; overflow: hidden; display: flex; align-items: center; justify-content: center; }
.mapa-quadro {
  position: relative; width: 1400px; height: 900px; flex-shrink: 0;
  transition: transform 0.35s ease;
}

/* ---------- anel do carrossel ---------- */
.mapa-anel-caixa { position: absolute; inset: 0; display: flex; align-items: center; justify-content: center; perspective: 2000px; }
.mapa-ambiente {
  position: absolute; inset: -10% -10% -10% -10%; z-index: -1; pointer-events: none;
  background: radial-gradient(ellipse 46% 40% at 50% 54%, color-mix(in srgb, var(--c) 13%, transparent), transparent 70%);
  transition: background 0.6s ease;
}
.mapa-anel { position: relative; width: 100%; height: 460px; transform-style: preserve-3d; }

.mapa-esfera {
  position: absolute; left: 50%; top: 50%; width: 190px; height: 190px; margin: -95px 0 0 -95px;
  padding: 0; border: 0; background: none; transform-style: preserve-3d;
  transition: transform 0.7s cubic-bezier(0.16, 0.8, 0.2, 1), opacity 0.7s ease, filter 0.6s ease;
}
.mapa-esfera .rosto {
  position: absolute; inset: 0; border-radius: 50%; z-index: 4;
  display: flex; align-items: center; justify-content: center; flex-direction: column; gap: 10px;
  transform: rotateX(-23deg); /* contragira — cancela a inclinação do anel, a esfera sempre encara a câmera */
}
/* sombra de "chão" — não contragira, então fica achatada no mesmo plano
   inclinado do anel, como se a esfera projetasse sombra numa superfície */
.mapa-esfera .chao {
  position: absolute; left: 8%; right: 8%; top: 84%; height: 46px; z-index: -1; pointer-events: none;
  background: radial-gradient(ellipse, rgb(0 0 0 / 0.55), transparent 72%);
  filter: blur(3px);
}
.mapa-esfera .halo {
  position: absolute; inset: -38%; border-radius: 50%; z-index: 0; pointer-events: none;
  background: radial-gradient(circle, color-mix(in srgb, var(--c) var(--glow, 22%), transparent), transparent 68%);
  filter: blur(6px);
  transition: opacity 0.5s ease;
}
.mapa-esfera.foco .halo { animation: mapa-respirar-halo 3.6s ease-in-out infinite; }
@keyframes mapa-respirar-halo {
  0%, 100% { opacity: 1; transform: scale(1); }
  50% { opacity: 0.78; transform: scale(1.07); }
}
.mapa-esfera .corpo {
  position: absolute; inset: 0; border-radius: 50%; z-index: 1; overflow: hidden; pointer-events: none;
  background:
    radial-gradient(circle at 28% 20%, rgb(255 255 255 / 0.75), rgb(255 255 255 / 0) 26%),
    radial-gradient(circle at 40% 32%, rgb(255 255 255 / 0.22), rgb(255 255 255 / 0) 42%),
    radial-gradient(circle at 68% 78%, color-mix(in srgb, var(--c) 62%, transparent), transparent 62%),
    linear-gradient(155deg, color-mix(in srgb, var(--c) 36%, transparent) 0%, color-mix(in srgb, var(--c) 10%, transparent) 50%, rgb(6 8 15 / 0.65) 100%);
  border: 1px solid color-mix(in srgb, var(--c) 48%, rgb(255 255 255 / 0.4));
  box-shadow:
    inset 0 1.5px 2px rgb(255 255 255 / 0.6),
    inset 0 -18px 30px -8px color-mix(in srgb, var(--c) 50%, transparent),
    inset 0 0 26px color-mix(in srgb, var(--c) 22%, transparent);
  backdrop-filter: blur(3px);
  transition: box-shadow 0.3s ease;
}
/* luz de borda (fresnel) — um anel bem fino e brilhante perto da borda,
   como luz do ambiente "contornando" o vidro */
.mapa-esfera .borda-luz {
  position: absolute; inset: 0; border-radius: 50%; z-index: 2; pointer-events: none;
  background: radial-gradient(circle, transparent 79%, rgb(255 255 255 / 0.5) 91%, transparent 97%);
  mix-blend-mode: screen; opacity: 0.85;
}
.mapa-esfera .veu {
  position: absolute; inset: 0; border-radius: 50%; z-index: 3; pointer-events: none;
  background: linear-gradient(200deg, rgb(255 255 255 / 0.18), transparent 40%);
  mix-blend-mode: screen;
}
.mapa-esfera .anel-fino {
  position: absolute; inset: -6px; border-radius: 50%; z-index: 0; pointer-events: none;
  border: 1px solid color-mix(in srgb, var(--c) 30%, transparent); opacity: 0.5;
}
.mapa-esfera .rosto svg {
  position: relative; width: 42px; height: 42px; color: #fff;
  filter: drop-shadow(0 0 8px color-mix(in srgb, var(--c) 85%, transparent));
  opacity: 0.92;
}
.mapa-esfera .nome {
  position: relative; font-family: var(--m-display); font-size: 14.5px; color: #fff;
  text-shadow: 0 2px 10px rgb(0 0 0 / 0.65); letter-spacing: 0.02em;
  opacity: 0; transition: opacity 0.3s ease; white-space: nowrap;
}
.mapa-esfera.foco { cursor: pointer; }
.mapa-esfera.foco .nome { opacity: 1; }
.mapa-esfera.foco .corpo {
  box-shadow:
    inset 0 1.5px 2px rgb(255 255 255 / 0.65),
    inset 0 -20px 34px -8px color-mix(in srgb, var(--c) 62%, transparent),
    inset 0 0 34px color-mix(in srgb, var(--c) 32%, transparent);
}
.mapa-esfera.foco .chao { background: radial-gradient(ellipse, rgb(0 0 0 / 0.62), transparent 72%); height: 54px; }
.mapa-esfera:hover:not(.foco) .corpo { box-shadow: inset 0 1.5px 2px rgb(255 255 255 / 0.6), inset 0 -18px 30px -8px color-mix(in srgb, var(--c) 62%, transparent), inset 0 0 30px color-mix(in srgb, var(--c) 28%, transparent); }

/* legenda do setor em foco, embaixo do anel */
.mapa-setor-sub { position: absolute; left: 0; right: 0; bottom: 21%; z-index: 6; display: flex; justify-content: center; }
.mapa-setor-sub button {
  background: none; border: 0; font-size: 12.5px; letter-spacing: 0.22em; text-transform: uppercase;
  color: rgb(var(--m-texto-3)); font-family: var(--m-display);
}
.mapa-setor-sub button:hover { color: rgb(var(--m-texto)); }

.mapa-navs {
  position: absolute; left: 50%; bottom: 9%; z-index: 20; transform: translateX(-50%);
  display: flex; align-items: center; gap: 2px; padding: 5px; border-radius: 999px;
}
.mapa-nav-btn {
  width: 38px; height: 38px; border-radius: 50%; display: flex; align-items: center; justify-content: center;
  background: transparent; border: 0; color: rgb(var(--m-texto-2));
  transition: color 0.2s, background 0.2s, box-shadow 0.2s;
}
.mapa-nav-btn:hover { color: rgb(var(--m-texto)); background: rgb(255 255 255 / 0.06); }
.mapa-nav-btn.ativo {
  background: color-mix(in srgb, var(--c) 16%, transparent);
  box-shadow: 0 0 18px color-mix(in srgb, var(--c) 38%, transparent);
}
.mapa-nav-btn.ativo:hover { background: color-mix(in srgb, var(--c) 22%, transparent); }
.mapa-nav-btn.ativo .ponto { width: 8px; height: 8px; border-radius: 50%; background: var(--c); box-shadow: 0 0 8px var(--c); }

.mapa-pontinhos { position: absolute; left: 0; right: 0; bottom: 4%; z-index: 20; display: flex; justify-content: center; gap: 7px; }
.mapa-pontinhos button { width: 5px; height: 5px; padding: 0; border: 0; border-radius: 50%; background: rgb(var(--m-texto-3)); opacity: 0.4; transition: all 0.25s ease; }
.mapa-pontinhos button.on { opacity: 1; background: rgb(var(--m-texto)); width: 16px; border-radius: 3px; }

/* ---------- estado expandido: constelação de funções do setor ---------- */
.mapa-exp-caixa { position: absolute; left: 50%; top: 50%; width: 0; height: 0; }
.mapa-exp-fundo {
  position: absolute; left: -700px; top: -450px; width: 1400px; height: 900px; z-index: -1;
  background: radial-gradient(circle at 50% 46%, color-mix(in srgb, var(--c) 15%, transparent), transparent 62%);
}
.mapa-exp-svg { position: absolute; left: -700px; top: -450px; overflow: visible; pointer-events: none; }

.mapa-exp-esfera {
  position: absolute; left: 0; top: 0; width: 232px; height: 232px; margin: -116px 0 0 -116px;
  border-radius: 50%; overflow: hidden;
  display: flex; align-items: center; justify-content: center;
}
.mapa-exp-esfera .halo {
  position: absolute; inset: -30%; border-radius: 50%; z-index: 0; pointer-events: none;
  background: radial-gradient(circle, color-mix(in srgb, var(--c) 46%, transparent), transparent 68%);
  filter: blur(10px);
}
.mapa-exp-esfera .corpo {
  position: absolute; inset: 0; border-radius: 50%; z-index: 1;
  background:
    radial-gradient(circle at 28% 20%, rgb(255 255 255 / 0.8), rgb(255 255 255 / 0) 26%),
    radial-gradient(circle at 40% 32%, rgb(255 255 255 / 0.22), rgb(255 255 255 / 0) 42%),
    radial-gradient(circle at 68% 78%, color-mix(in srgb, var(--c) 58%, transparent), transparent 64%),
    linear-gradient(155deg, color-mix(in srgb, var(--c) 34%, transparent) 0%, color-mix(in srgb, var(--c) 10%, transparent) 50%, rgb(6 8 15 / 0.65) 100%);
  border: 1.5px solid color-mix(in srgb, var(--c) 55%, rgb(255 255 255 / 0.36));
  box-shadow:
    inset 0 2px 3px rgb(255 255 255 / 0.55),
    inset 0 -26px 44px -10px color-mix(in srgb, var(--c) 58%, transparent),
    inset 0 0 40px color-mix(in srgb, var(--c) 26%, transparent),
    0 0 110px color-mix(in srgb, var(--c) 40%, transparent);
  backdrop-filter: blur(3px);
}
.mapa-exp-esfera .borda-luz {
  position: absolute; inset: 0; border-radius: 50%; z-index: 2; pointer-events: none;
  background: radial-gradient(circle, transparent 80%, rgb(255 255 255 / 0.5) 92%, transparent 97%);
  mix-blend-mode: screen; opacity: 0.85;
}
.mapa-exp-esfera .veu {
  position: absolute; inset: 0; border-radius: 50%; z-index: 3; pointer-events: none;
  background: linear-gradient(200deg, rgb(255 255 255 / 0.14), transparent 40%);
  mix-blend-mode: screen;
}
.mapa-exp-esfera .rosto { position: relative; z-index: 4; display: flex; flex-direction: column; align-items: center; gap: 10px; }
.mapa-exp-esfera .rosto svg { width: 50px; height: 50px; color: #fff; filter: drop-shadow(0 0 10px color-mix(in srgb, var(--c) 85%, transparent)); }
.mapa-exp-esfera .nome { font-family: var(--m-display); font-size: 18px; color: #fff; text-shadow: 0 2px 10px rgb(0 0 0 / 0.6); letter-spacing: 0.02em; }

.mapa-bloco {
  position: absolute; width: 208px; padding: 12px 15px; border-radius: 13px; text-align: left;
  background: var(--m-vidro); backdrop-filter: blur(10px); -webkit-backdrop-filter: blur(10px);
  border: 1px solid var(--m-linha); transform: translate(-50%, -50%);
  transition: border-color 0.2s ease, box-shadow 0.2s ease, transform 0.2s ease;
}
.mapa-bloco:not(.link) { cursor: default; }
.mapa-bloco:hover,
.mapa-bloco.destaque { transform: translate(-50%, -50%) scale(1.045); border-color: color-mix(in srgb, var(--c) 55%, transparent); }
.mapa-bloco.destaque { box-shadow: 0 0 0 1px color-mix(in srgb, var(--c) 55%, transparent), 0 0 28px color-mix(in srgb, var(--c) 45%, transparent); animation: mapa-pulso 1.1s ease-in-out 2; }
@keyframes mapa-pulso { 50% { box-shadow: 0 0 0 1px color-mix(in srgb, var(--c) 75%, transparent), 0 0 42px color-mix(in srgb, var(--c) 65%, transparent); } }
.mapa-bloco .n { display: flex; align-items: center; gap: 8px; font-size: 13px; color: rgb(var(--m-texto)); line-height: 1.3; }
.mapa-bloco .n i { width: 7px; height: 7px; border-radius: 50%; background: var(--c); box-shadow: 0 0 8px var(--c); flex-shrink: 0; }
.mapa-bloco .n i.dev { background: transparent; border: 1.3px solid rgb(var(--m-texto-3)); box-shadow: none; }
.mapa-bloco .o { display: block; margin-top: 4px; margin-left: 15px; font-size: 10.5px; color: rgb(var(--m-texto-3)); }

.mapa-trilha {
  height: 34px; padding: 0 14px; border-radius: 9px; min-width: 0; flex-shrink: 1;
  font-size: 12px; color: rgb(var(--m-texto-3)); display: flex; align-items: center; gap: 5px;
  white-space: nowrap; overflow: hidden;
}
.mapa-trilha .pref { display: flex; align-items: center; gap: 5px; flex-shrink: 0; }
.mapa-trilha b { font-weight: 500; overflow: hidden; text-overflow: ellipsis; }
.mapa-voltar {
  height: 34px; padding: 0 15px; border-radius: 999px; font-size: 12px; color: rgb(var(--m-texto-2));
  margin-left: auto; flex-shrink: 0; display: flex; align-items: center; gap: 6px;
}
.mapa-voltar:hover { color: rgb(var(--m-texto)); }
@media (max-width: 639px) {
  .mapa-trilha .pref { display: none; }
  .mapa-voltar .txt { display: none; }
  .mapa-voltar { width: 34px; padding: 0; justify-content: center; }
}

/* legenda */
.mapa-legenda {
  position: absolute; left: 16px; bottom: 16px; z-index: 20;
  display: flex; gap: 14px; padding: 7px 12px; border-radius: 10px;
  font-size: 11px; color: rgb(var(--m-texto-3));
}
.mapa-legenda span { display: flex; align-items: center; gap: 6px; }
.mapa-legenda i { width: 8px; height: 8px; border-radius: 50%; background: rgb(var(--m-texto-2)); }
.mapa-legenda i.vazado { background: transparent; border: 1.5px solid rgb(var(--m-texto-2)); }
@media (max-width: 639px) { .mapa-legenda { display: none; } }

@media (prefers-reduced-motion: reduce) {
  .mapa-estrela { animation: none; }
  .mapa-quadro, .mapa-esfera { transition: none; }
  .mapa-esfera.foco .halo { animation: none; }
  .mapa-exp-svg circle { display: none; }
}
